<div class='tgo-status'>
    <section class='tgo-bars'>
        <div class='tgo-pool'>
            <div class='tgo-pool-head'>
                <span class='tgo-k'>{{localize 'TGO.Sheet.health'}}</span>
                <output class='tgo-pool-total'>{{system.health.value}} / {{system.health.max}}</output>
            </div>
            <div
                class='tgo-meter tgo-meter-health is-{{healthTone}}'
                role='progressbar'
                aria-label='{{localize "TGO.Sheet.health"}}'
                aria-valuemin='0'
                aria-valuemax='{{system.health.max}}'
                aria-valuenow='{{system.health.value}}'
                style='--tgo-meter-fill: {{healthPercent}}%;'
            >
                <span class='tgo-meter-fill'></span>
            </div>
            <div class='tgo-pool-values'>
                <input
                    type='number'
                    name='system.health.value'
                    value='{{system.health.value}}'
                    min='0'
                    step='1'
                />
                <span class='tgo-sep'>/</span>
                <input
                    type='number'
                    name='system.health.max'
                    value='{{system.health.max}}'
                    min='0'
                    step='1'
                />
            </div>
        </div>
        <div class='tgo-pool'>
            <div class='tgo-pool-head'>
                <span class='tgo-k'>{{localize 'TGO.Sheet.mana'}}</span>
                <output class='tgo-pool-total'>{{system.mana.value}} / {{system.mana.max}}</output>
            </div>
            <div
                class='tgo-meter tgo-meter-mana'
                role='progressbar'
                aria-label='{{localize "TGO.Sheet.mana"}}'
                aria-valuemin='0'
                aria-valuemax='{{system.mana.max}}'
                aria-valuenow='{{system.mana.value}}'
                style='--tgo-meter-fill: {{manaPercent}}%;'
            >
                <span class='tgo-meter-fill'></span>
            </div>
            <div class='tgo-pool-values'>
                <input
                    type='number'
                    name='system.mana.value'
                    value='{{system.mana.value}}'
                    min='0'
                    step='1'
                />
                <span class='tgo-sep'>/</span>
                <input
                    type='number'
                    name='system.mana.max'
                    value='{{system.mana.max}}'
                    min='0'
                    step='1'
                />
            </div>
        </div>
        <div class='tgo-ca'>
            <span class='tgo-k'>{{localize 'TGO.Sheet.ca'}}</span>
            <strong class='tgo-ca-value'>{{system.ca}}</strong>
        </div>
    </section>

    <section class='tgo-attributes'>
        {{#each attributes}}
            <label class='tgo-attribute'>
                <span class='tgo-k'>{{localize this.label}}</span>
                <input
                    type='number'
                    name='system.attributes.{{this.key}}.value'
                    value='{{this.value}}'
                    min='0'
                    step='1'
                />
            </label>
        {{/each}}
    </section>

    <section class='tgo-masteries'>
        <span class='tgo-k'>{{localize 'TGO.Sheet.masteries'}}</span>
        {{#if system.masteries.length}}
            <ul class='tgo-mastery-list'>
                {{#each system.masteries}}
                    <li><span>{{this.type}}</span><strong>{{this.value}}</strong></li>
                {{/each}}
            </ul>
        {{else}}
            <p class='tgo-empty'>{{localize 'TGO.Sheet.noMasteries'}}</p>
        {{/if}}
    </section>
</div>
